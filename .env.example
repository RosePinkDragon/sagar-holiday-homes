# Supabase (admin panel + enquiry storage). Project Settings -> API.
# The anon / publishable key is public by design; access is enforced by RLS.
# Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "true" at launch flips noindex off (see identity.live).
NEXT_PUBLIC_SITE_LIVE=
